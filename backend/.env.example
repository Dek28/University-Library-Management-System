# ---------------------------------------------------------------------------
# ULMS backend configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# A single-node replica set enables MongoDB transactions. On a standalone
# mongod the app still works: circulation falls back to sequential writes
# guarded by conditional updates and unique indexes.
MONGO_URI=mongodb://127.0.0.1:27017/ulms
MONGO_URI_TEST=mongodb://127.0.0.1:27017/ulms_test

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with the placeholder values below.
JWT_ACCESS_SECRET=change-me-in-production-use-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-too-use-a-different-64-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=ulms_rt

# --- Security --------------------------------------------------------------
# Production default is 12; tests use 4.
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
# In production COOKIE_SECURE must be true (the server refuses to start otherwise),
# and CORS_ORIGINS and FRONTEND_URL must be set to the real frontend origin.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File storage ----------------------------------------------------------
# `local` writes under UPLOAD_DIR. Add an s3/cloudinary/azure driver in
# src/services/storage/ and switch this value; no call sites change.
STORAGE_DRIVER=local
UPLOAD_DIR=
UPLOAD_PUBLIC_BASE_URL=/uploads
MAX_FILE_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5

# --- Scheduled jobs --------------------------------------------------------
ENABLE_JOBS=true
CRON_OVERDUE=0 1 * * *
CRON_REMINDERS=30 1 * * *
CRON_RESERVATIONS=0 2 * * *

# --- Seeding (development only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=ChangeMe123!

LOG_LEVEL=info

# Shows password reset links and error stack traces. Defaults to true only when
# NODE_ENV is development or test. Never enable it in production.
EXPOSE_DEV_SECRETS=

# --- Proxy and API docs ----------------------------------------------------
# Number of reverse proxies in front of the API whose X-Forwarded-For is trusted.
# Defaults to 1 in production and 0 elsewhere; 0 ignores the header entirely.
TRUST_PROXY=
# Serves /api-docs. Defaults to on outside production and off in production.
ENABLE_API_DOCS=
